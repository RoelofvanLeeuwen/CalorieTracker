@inject IConsumptionEntryRepository ConsumptionRepo

@if (_isOpen && _entry is not null)
{
    <div class="gc-modal-backdrop"
         @onmousedown="() => _backdropMouseDown = true"
         @onmouseup="OnBackdropMouseUp">
        <div class="gc-modal" style="max-width: 420px;"
             @onmousedown:stopPropagation @onmouseup:stopPropagation @onclick:stopPropagation>

            <div class="gc-modal-head">
                <div>
                    <div class="gc-eyebrow" style="margin-bottom:2px">@_entry.Product.Name</div>
                    <strong style="font-size:16px">Consumptie bewerken</strong>
                </div>
                <button class="gc-iconbtn" @onclick="Sluiten" aria-label="Sluiten">
                    <GcIcon Name="close" Size="18" />
                </button>
            </div>

            <div class="gc-modal-body">
                <div class="gc-form">
                    <label class="gc-field">
                        <span>
                            Hoeveelheid
                            @if (_entry.Product.DefaultUnit == UnitTypeDto.Piece)
                            {
                                <span style="color:var(--gc-ink-3)"> (@(_entry.Product.UnitLabel ?? "stuk"))</span>
                            }
                            else
                            {
                                <span style="color:var(--gc-ink-3)"> (gram)</span>
                            }
                        </span>
                        <input type="number" @bind="_quantity" min="0.1" step="0.1" />
                    </label>

                    <div class="gc-form-row">
                        <label class="gc-field">
                            <span>Datum</span>
                            <input type="date"
                                   value="@_consumedAt.ToString("yyyy-MM-dd")"
                                   @onchange="OnDateChanged" />
                        </label>
                        <label class="gc-field">
                            <span>Tijd</span>
                            <input type="time"
                                   value="@_consumedAt.ToString("HH:mm")"
                                   @onchange="OnTimeChanged" />
                        </label>
                    </div>

                    @if (_fout is not null)
                    {
                        <div class="gc-alert">
                            <GcIcon Name="info" Size="16" />
                            <div>@_fout</div>
                        </div>
                    }
                </div>
            </div>

            <div class="gc-modal-foot">
                <button class="gc-btn gc-btn-ghost" @onclick="Sluiten">Annuleren</button>
                <button class="gc-btn" @onclick="OpslaanAsync" disabled="@_bezig">Opslaan</button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool                  _isOpen;
    private bool                  _backdropMouseDown;
    private bool                  _bezig;
    private string?               _fout;
    private ConsumptionEntryDto?  _entry;
    private decimal               _quantity;
    private DateTime              _consumedAt;

    public void Open(ConsumptionEntryDto entry)
    {
        _entry      = entry;
        _quantity   = entry.Quantity;
        _consumedAt = entry.ConsumedAt;
        _fout       = null;
        _bezig      = false;
        _isOpen     = true;
        StateHasChanged();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
            _consumedAt = d.ToDateTime(TimeOnly.FromDateTime(_consumedAt));
    }

    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var t))
            _consumedAt = DateOnly.FromDateTime(_consumedAt).ToDateTime(t);
    }

    private void OnBackdropMouseUp()
    {
        if (_backdropMouseDown) Sluiten();
        _backdropMouseDown = false;
    }

    private void Sluiten()
    {
        _isOpen = false;
        _entry  = null;
        StateHasChanged();
    }

    private async Task OpslaanAsync()
    {
        if (_quantity <= 0)
        {
            _fout = "Hoeveelheid moet groter zijn dan 0.";
            return;
        }

        _fout  = null;
        _bezig = true;
        await ConsumptionRepo.UpdateAsync(_entry!.Id, new UpdateConsumptionEntryDto(_quantity, _consumedAt));
        _bezig  = false;
        _isOpen = false;
        _entry  = null;
        StateHasChanged();
        await OnSaved.InvokeAsync();
    }
}
