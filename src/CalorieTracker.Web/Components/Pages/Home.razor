@page "/"

<PageTitle>Home — CalorieTracker</PageTitle>

<div class="gc-pageheader">
    <div>
        <div class="gc-eyebrow">Dashboard</div>
        <h1 class="gc-h1">Welkom bij CalorieTracker</h1>
        <p class="gc-sub">De applicatie is klaar voor de eerste user story.</p>
    </div>
</div>

<div class="gc-grid gc-grid-3">
    <div class="gc-stat">
        <div class="gc-stat-label">Calorieën vandaag</div>
        <div class="gc-stat-value">—</div>
        <div class="gc-stat-delta">Nog geen gegevens</div>
    </div>
    <div class="gc-stat">
        <div class="gc-stat-label">Dagdoel</div>
        <div class="gc-stat-value">—</div>
        <div class="gc-stat-delta">Nog niet ingesteld</div>
    </div>
    <div class="gc-stat">
        <div class="gc-stat-label">Ingevoerde producten</div>
        <div class="gc-stat-value">—</div>
        <div class="gc-stat-delta">Nog geen invoer</div>
    </div>
</div>

<div class="gc-grid gc-grid-2" style="margin-top: 24px;">
    <div class="gc-card">
        <div class="gc-card-head">
            <div>
                <div class="gc-card-title">Technische basis</div>
                <div class="gc-card-sub">Initiële setup voltooid</div>
            </div>
        </div>
        <div class="gc-card-body">
            <ul style="margin: 0; padding: 0 0 0 18px; color: var(--gc-ink-2); font-size: 14px; line-height: 1.8;">
                <li>.NET 10 · Blazor Interactive Server</li>
                <li>Clean Architecture (Domain / Application / Infrastructure / Web)</li>
                <li>GC design system — Manrope · magenta accent</li>
                <li>EF Core 10 + SQLite (klaar voor configuratie)</li>
            </ul>
        </div>
    </div>
    <div class="gc-card">
        <div class="gc-card-head">
            <div>
                <div class="gc-card-title">Volgende stap</div>
                <div class="gc-card-sub">Scope en US-001</div>
            </div>
        </div>
        <div class="gc-card-body">
            <div class="gc-alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px">
                    <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
                </svg>
                <div>
                    Leg de applicatiescope vast in <code>specification.md</code>,
                    bespreek en verfijn daarna US-001, en maak een featurebranch aan na akkoord.
                </div>
            </div>
        </div>
    </div>
</div>
