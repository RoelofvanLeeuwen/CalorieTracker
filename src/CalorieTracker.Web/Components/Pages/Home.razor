@page "/"
@inject IUserProfileRepository ProfileRepo
@inject IConsumptionEntryRepository ConsumptionRepo
@inject IActivityRepository ActivityRepo
@inject NavigationManager Nav

<PageTitle>Dashboard — CalorieTracker</PageTitle>

@if (_loading)
{
    <div style="padding: 40px; text-align: center; color: var(--gc-ink-3);">Laden…</div>
}
else if (_profile is null)
{
    @* Redirect handled in OnInitializedAsync; show nothing while navigating *@
}
else
{
    var goal      = DailyGoalCalculator.Calculate(_profile);
    var eaten     = _dayLog?.TotalKcal    ?? 0m;
    var remaining = goal.TotalKcal - eaten;
    var isOver    = eaten > goal.TotalKcal;
    var kcalPct   = goal.TotalKcal > 0 ? (double)(eaten / goal.TotalKcal) * 100.0 : 0;

    <div class="gc-pageheader">
        <div>
            <div class="gc-eyebrow">Dashboard</div>
            <h1 class="gc-h1">@_today.ToString("dddd d MMMM", _nl)</h1>
        </div>
        <a class="gc-btn gc-btn-ghost gc-btn-sm" href="/dagboek">Naar dagboek</a>
    </div>

    @* ── Kcal voortgang ── *@
    <div class="gc-dashboard-goal">
        <div class="gc-goal-head">
            <div>
                <div class="gc-goal-label">Calorieën</div>
                <div class="gc-goal-eaten">
                    @eaten.ToString("F0")
                    <span> / @goal.TotalKcal.ToString("F0") kcal</span>
                </div>
            </div>
            <div class="gc-goal-remaining @(isOver ? "is-over" : "")">
                @if (isOver)
                {
                    <span>@(eaten - goal.TotalKcal).ToString("F0") kcal over doel</span>
                }
                else
                {
                    <span>@remaining.ToString("F0") kcal resterend</span>
                }
            </div>
        </div>
        <div class="gc-progress">
            <div class="gc-progress-fill @(isOver ? "is-over" : "")"
                 style="width: @(Math.Min(kcalPct, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
        </div>
    </div>

    @* ── Macro voortgang ── *@
    <div class="gc-macro-grid">
        @{
            var carbsEaten   = _dayLog?.TotalCarbs   ?? 0m;
            var fatEaten     = _dayLog?.TotalFat     ?? 0m;
            var proteinEaten = _dayLog?.TotalProtein ?? 0m;
            var carbsPct     = goal.CarbsGrams   > 0 ? Math.Min((double)(carbsEaten   / goal.CarbsGrams)   * 100.0, 100) : 0;
            var fatPct       = goal.FatGrams     > 0 ? Math.Min((double)(fatEaten     / goal.FatGrams)     * 100.0, 100) : 0;
            var proteinPct   = goal.ProteinGrams > 0 ? Math.Min((double)(proteinEaten / goal.ProteinGrams) * 100.0, 100) : 0;
        }
        <div class="gc-macro-card">
            <div class="gc-macro-card-label">Koolhydraten</div>
            <div class="gc-macro-card-values">
                <span class="gc-macro-card-eaten">@carbsEaten.ToString("F0") g</span>
                <span class="gc-macro-card-goal">/ @goal.CarbsGrams.ToString("F0") g</span>
            </div>
            <div class="gc-macro-bar">
                <div class="gc-macro-fill carbs"
                     style="width: @carbsPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
        <div class="gc-macro-card">
            <div class="gc-macro-card-label">Vetten</div>
            <div class="gc-macro-card-values">
                <span class="gc-macro-card-eaten">@fatEaten.ToString("F0") g</span>
                <span class="gc-macro-card-goal">/ @goal.FatGrams.ToString("F0") g</span>
            </div>
            <div class="gc-macro-bar">
                <div class="gc-macro-fill fat"
                     style="width: @fatPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
        <div class="gc-macro-card">
            <div class="gc-macro-card-label">Eiwitten</div>
            <div class="gc-macro-card-values">
                <span class="gc-macro-card-eaten">@proteinEaten.ToString("F0") g</span>
                <span class="gc-macro-card-goal">/ @goal.ProteinGrams.ToString("F0") g</span>
            </div>
            <div class="gc-macro-bar">
                <div class="gc-macro-fill protein"
                     style="width: @proteinPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    </div>

    @* ── Activiteiten ── *@
    <section class="gc-meal-section">
        <div class="gc-meal-header">
            <div class="gc-meal-header-left">
                <span class="gc-meal-title">Activiteiten</span>
                @if ((_dayActivityLog?.TotalKcalBurned ?? 0m) > 0)
                {
                    <span class="gc-meal-kcal gc-meal-kcal-activity">
                        @_dayActivityLog!.TotalKcalBurned.ToString("F0") kcal verbrand
                    </span>
                }
            </div>
            <button class="gc-btn gc-btn-ghost gc-btn-sm" @onclick="OpenActiviteitWizard">
                <GcIcon Name="plus" Size="14" /> Toevoegen
            </button>
        </div>
        @if (_dayActivityLog?.Activities.Count > 0)
        {
            <div class="gc-card" style="margin-top: 8px;">
                <table class="gc-table">
                    <thead>
                        <tr>
                            <th>Activiteit</th>
                            <th class="gc-col-num">Duur</th>
                            <th class="gc-col-num">kcal verbrand</th>
                            <th class="gc-col-num gc-col-macro">Tijd</th>
                            <th style="width:72px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _dayActivityLog.Activities)
                        {
                            <tr>
                                <td>@a.Name</td>
                                <td class="gc-col-num">@a.DurationMinutes min</td>
                                <td class="gc-col-num">@a.KcalBurned.ToString("F0")</td>
                                <td class="gc-col-num gc-col-macro">@a.PerformedAt.ToString("HH:mm")</td>
                                <td style="width:72px;padding:0 4px">
                                    <div style="display:flex;gap:2px;justify-content:flex-end">
                                        <button class="gc-iconbtn"
                                                style="width:30px;height:30px;border-radius:6px"
                                                @onclick="() => _bewerkenActiviteitModal.Open(a)"
                                                aria-label="Bewerken">
                                            <GcIcon Name="pencil" Size="14" />
                                        </button>
                                        <button class="gc-iconbtn gc-iconbtn-danger"
                                                style="width:30px;height:30px;border-radius:6px"
                                                @onclick="() => VraagVerwijderActiviteit(a.Id)"
                                                aria-label="Verwijderen">
                                            <GcIcon Name="trash" Size="14" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ── Maaltijdmomenten ── *@
    @if (_dayLog is not null)
    {
        @foreach (var mm in _dayLog.MealMoments)
        {
            var isExpanded = _expanded.Contains(mm.MealMoment);
            <section class="gc-meal-section">
                <div class="gc-meal-header">
                    <div class="gc-meal-header-left"
                         style="cursor: pointer; user-select: none;"
                         @onclick="() => ToggleMealMoment(mm.MealMoment)">
                        <span style="display:inline-flex;align-items:center;transition:transform 0.2s;transform:@(isExpanded ? "rotate(0deg)" : "rotate(-90deg)")">
                            <GcIcon Name="chevron" Size="16" />
                        </span>
                        <span class="gc-meal-title">@mm.Label</span>
                        @if (mm.TotalKcal > 0)
                        {
                            <span class="gc-meal-kcal">@mm.TotalKcal.ToString("F0") kcal</span>
                        }
                    </div>
                    <button class="gc-btn gc-btn-ghost gc-btn-sm"
                            @onclick="() => OpenConsumptieWizard(mm.MealMoment)"
                            @onclick:stopPropagation>
                        <GcIcon Name="plus" Size="14" /> Toevoegen
                    </button>
                </div>
                @if (isExpanded && mm.Entries.Count > 0)
                {
                    <div class="gc-card" style="margin-top: 8px;">
                        <table class="gc-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="gc-col-num">kcal</th>
                                    <th class="gc-col-num gc-col-macro">Koolh.</th>
                                    <th class="gc-col-num gc-col-macro">Vet</th>
                                    <th class="gc-col-num gc-col-macro">Eiwit</th>
                                    <th style="width:72px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in mm.Entries)
                                {
                                    <tr>
                                        <td>@entry.Product.Name</td>
                                        <td class="gc-col-num">@entry.TotalKcal.ToString("F0")</td>
                                        <td class="gc-col-num gc-col-macro">@entry.TotalCarbs.ToString("F1") g</td>
                                        <td class="gc-col-num gc-col-macro">@entry.TotalFat.ToString("F1") g</td>
                                        <td class="gc-col-num gc-col-macro">@entry.TotalProtein.ToString("F1") g</td>
                                        <td style="width:72px;padding:0 4px">
                                            <div style="display:flex;gap:2px;justify-content:flex-end">
                                                <button class="gc-iconbtn"
                                                        style="width:30px;height:30px;border-radius:6px"
                                                        @onclick="() => _bewerkenConsumptieModal.Open(entry)"
                                                        aria-label="Bewerken">
                                                    <GcIcon Name="pencil" Size="14" />
                                                </button>
                                                <button class="gc-iconbtn gc-iconbtn-danger"
                                                        style="width:30px;height:30px;border-radius:6px"
                                                        @onclick="() => VraagVerwijderConsumptie(entry.Id)"
                                                        aria-label="Verwijderen">
                                                    <GcIcon Name="trash" Size="14" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }

    <ConsumptieWizard          @ref="_consumptieWizard"          OnCompleted="LoadDayLog" />
    <ActiviteitWizard          @ref="_activiteitWizard"          OnCompleted="LoadDayLog"
                               UserWeightKg="@(_profile.WeightKg)" />
    <BevestigingModal          @ref="_bevestigingModal"
                               Titel="Verwijderen"
                               Bericht="Weet je zeker dat je dit wilt verwijderen?" />
    <BewerkenConsumptieModal   @ref="_bewerkenConsumptieModal"   OnSaved="LoadDayLog" />
    <BewerkenActiviteitModal   @ref="_bewerkenActiviteitModal"   OnSaved="LoadDayLog" />
}

@code {
    private static readonly System.Globalization.CultureInfo _nl = new("nl-NL");

    private DateOnly            _today = DateOnly.FromDateTime(DateTime.Today);
    private UserProfileDto?     _profile;
    private DayLogDto?          _dayLog;
    private DayActivityLogDto?  _dayActivityLog;
    private ConsumptieWizard          _consumptieWizard         = null!;
    private ActiviteitWizard          _activiteitWizard         = null!;
    private BevestigingModal          _bevestigingModal         = null!;
    private BewerkenConsumptieModal   _bewerkenConsumptieModal  = null!;
    private BewerkenActiviteitModal   _bewerkenActiviteitModal  = null!;
    private bool                      _loading = true;
    private HashSet<MealMomentDto>    _expanded = [];

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileRepo.GetAsync();
        if (_profile is null)
        {
            Nav.NavigateTo("/profiel");
            return;
        }
        await LoadDayLog();
        _loading = false;
    }

    private async Task LoadDayLog()
    {
        _dayLog         = await ConsumptionRepo.GetDayLogAsync(_today);
        _dayActivityLog = await ActivityRepo.GetDayLogAsync(_today);
        StateHasChanged();
    }

    private void ToggleMealMoment(MealMomentDto mm)
    {
        if (!_expanded.Add(mm))
            _expanded.Remove(mm);
    }

    private void VraagVerwijderConsumptie(int id) =>
        _bevestigingModal.Open(() => VerwijderConsumptie(id));

    private async Task VerwijderConsumptie(int id)
    {
        await ConsumptionRepo.DeleteAsync(id);
        await LoadDayLog();
    }

    private void VraagVerwijderActiviteit(int id) =>
        _bevestigingModal.Open(() => VerwijderActiviteit(id));

    private async Task VerwijderActiviteit(int id)
    {
        await ActivityRepo.DeleteAsync(id);
        await LoadDayLog();
    }

    private void OpenConsumptieWizard(MealMomentDto mealMoment) =>
        _consumptieWizard.Open(mealMoment, _today);

    private void OpenActiviteitWizard() =>
        _activiteitWizard.Open(_today);
}
